[Unit]
Description=Asistente de la Sede del Caribe (el congo): responde las preguntas del sitio con Claude
After=network-online.target
Wants=network-online.target

[Service]
User=sedeweb
Group=sedeweb
EnvironmentFile=/etc/sede-web/sede.env
ExecStart=/usr/bin/python3 /opt/sede-web/servidor/asistente.py
# asistente.py sale solo cuando su código cambia (git pull); systemd lo vuelve a arrancar
Restart=always
RestartSec=3
# Endurecimiento: solo lee; no escribe en ningún lado
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
