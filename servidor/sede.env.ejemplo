# Copiar a /etc/sede-web/sede.env en el servidor.
# Carpeta «Sitio web Sede del Caribe».
# Al pasarla a una unidad compartida institucional, solo cambia este ID.
SEDE_DRIVE_CARPETA=ID_DE_LA_CARPETA_EN_DRIVE
SEDE_CREDENCIALES=/etc/sede-web/cuenta-servicio.json
# Asistente CONGO 2.0 (el congo). Ver servidor/congo/congo/config.py para todas las variables.
# Proveedor: gemini (gratuito; Google puede usar y revisar lo que recibe) o claude (de pago)
CONGO_PROVEEDOR=gemini
GEMINI_API_KEY=
# CONGO_MODELO_GEMINI=gemini-flash-latest
# ANTHROPIC_API_KEY=
# Clave para /api/documents y /api/admin (cabecera X-Congo-Clave). Generar con: openssl rand -hex 24
CONGO_CLAVE_ADMIN=
# Carpeta «Documentos del congo» en Drive, con su hoja de metadatos
CONGO_DRIVE_CARPETA=
# Opcionales
# CONGO_UMBRAL=0.45          similitud mínima para usar un fragmento (calibrar con documentos reales)
# CONGO_POR_HORA=30          preguntas por hora y por IP
# CONGO_POR_DIA=1000         preguntas por día en total (protege la cuota gratuita)
# CONGO_VISITAS=1            0 apaga el conteo de visitas propio (sin cookies; ver README)
# CONGO_SINCRONIZAR_MIN=10   cada cuánto se revisan Drive y las páginas del sitio
