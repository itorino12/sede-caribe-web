# Copiar a /etc/sede-web/sede.env en el servidor.
# Carpeta «Sitio web Sede del Caribe».
# Al pasarla a una unidad compartida institucional, solo cambia este ID.
SEDE_DRIVE_CARPETA=ID_DE_LA_CARPETA_EN_DRIVE
SEDE_CREDENCIALES=/etc/sede-web/cuenta-servicio.json
# Asistente (el congo): llave de la API de Claude (console.anthropic.com). Sin ella, el congo solo busca en el sitio.
ANTHROPIC_API_KEY=
# Opcionales: modelo y topes de uso
# SEDE_ASISTENTE_MODELO=claude-haiku-5-5
# SEDE_ASISTENTE_POR_HORA=30
# SEDE_ASISTENTE_POR_DIA=3000
